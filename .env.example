# Pravidhi OS documentation/development placeholders
PRAVIDHI_API_URL=https://pravidhisolutions.in/pravidhi/v3
PRAVIDHI_TENANT_ID=pravidh

# Never commit real credentials, OAuth secrets, bearer tokens, or private keys.

# Commercial gateway security
# Generate a long random secret and store it outside source control.
PRAVIDHI_API_KEY=
# Comma-separated browser origins allowed by CORS.
PRAVIDHI_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# Development-only override. Never enable this in production.
PRAVIDHI_ALLOW_UNAUTHENTICATED_DEV=false

# Firebase end-user identity verification (server-side only)
FIREBASE_PROJECT_ID=pravidhi-os
# Configure Application Default Credentials or GOOGLE_APPLICATION_CREDENTIALS on the server.
# Never commit Firebase service-account JSON or private keys.
#
# Explicit operator-provisioned Firebase UID -> existing Pravidhi account mapping.
# Put this JSON in the deployment secret/config store, NOT in a committed .env file.
# Keys must be Firebase UIDs; do not key by email or trust client-provided claims.
# Example shape (replace all placeholders with real, pre-existing records):
# PRAVIDHI_FIREBASE_USER_MAPPINGS_JSON={"FIREBASE_UID":{"account_id":"EXISTING_ACCOUNT_ID","tenant_id":"EXISTING_TENANT_ID","role":"operator"}}
# Supported roles: viewer, user, operator, admin. Unknown UIDs are denied by default.
# Only grant operator/admin after explicitly verifying the account and tenant owner.

# Gemini provider (server-side only; required to call Gemini models).
# Create a key in Google AI Studio and inject it into the API process environment.
# Never put this key in dashboard JavaScript or commit a real key.
GEMINI_API_KEY=
