# Pravidhi OS control-plane configuration shape only.
PRAVIDHI_DATABASE_URL=sqlite:///~/.pravidhi/pravidhi.db
PRAVIDHI_AGENT_REGISTRATION_TOKEN=
PRAVIDHI_AGENT_BOOTSTRAP_TENANT=default
PRAVIDHI_TENANT_ID=default
PRAVIDHI_API_ROLE=operator
PRAVIDHI_TRUST_IDENTITY_HEADERS=false

# Optional agent endpoint configuration
PRAVIDHI_CONTROL_URL=https://mcp.pravidhisolutions.in
PRAVIDHI_AGENT_ID=
PRAVIDHI_AGENT_NAME=
PRAVIDHI_AGENT_CAPABILITIES=[]
PRAVIDHI_AGENT_HEARTBEAT_SECONDS=30

# Android/Termux worker bridge
PRAVIDHI_AGENT_POLL_SECONDS=1
PRAVIDHI_TERMUX_MCP_URL=http://127.0.0.1:8080
PRAVIDHI_AGENT_MAX_RESULT_BYTES=200000
TERMUX_MCP_AUTH_TOKEN=
